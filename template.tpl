      mockData.autoMapUserDataParameters = false;
      mockData.userDataParametersList = scenario.params;

      mock('sendHttpRequest', (url, options, body) => {
        const parsed = JSON.parse(body);
        scenario.assertFn(parsed.events[0].user);
