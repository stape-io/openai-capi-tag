- name: '[Click ID] oppref source priority URL over cookie over common_cookie over
    eventData'
  code: |-
    mockData.autoMapServerEventDataParameters = true;

    [
      {
        pageLocation: 'https://example.com/?oppref=from-url',
        cookie: ['from-cookie'],
        eventDataExtra: { __oppref: 'from-ed', oppref: 'from-ed-nopfx', common_cookie: { __oppref: 'from-cc' } },
        expected: 'from-url'
      },
      {
        pageLocation: 'https://example.com/',
        cookie: ['from-cookie'],
        eventDataExtra: { __oppref: 'from-ed', oppref: 'from-ed-nopfx', common_cookie: { __oppref: 'from-cc' } },
        expected: 'from-cookie'
      },
      {
        pageLocation: 'https://example.com/',
        cookie: [],
        eventDataExtra: { common_cookie: { __oppref: 'from-cc' }, __oppref: 'from-ed', oppref: 'from-ed-nopfx' },
        expected: 'from-cc'
      },
      {
        pageLocation: 'https://example.com/',
        cookie: [],
        eventDataExtra: { __oppref: 'from-ed', oppref: 'from-ed-nopfx' },
        expected: 'from-ed'
      },
      {
        pageLocation: 'https://example.com/',
        cookie: [],
        eventDataExtra: { oppref: 'from-ed-nopfx' },
        expected: 'from-ed-nopfx'
      }
    ].forEach((scenario) => {
      const eventDataBase = { event_name: 'page_view', page_location: scenario.pageLocation };
      for (const key in scenario.eventDataExtra) eventDataBase[key] = scenario.eventDataExtra[key];
      mock('getAllEventData', () => eventDataBase);

      mock('getCookieValues', (name) => {
        if (name === '__oppref') return scenario.cookie;
