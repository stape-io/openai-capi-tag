    [
      {
        params: [{ name: 'email_sha256', value: 'test@example.com' }],
        assertFn: (user) => assertThat(user.email_sha256).isEqualTo(emailHash)
      },
      {
        params: [{ name: 'email_sha256', value: alreadyHashed }],
